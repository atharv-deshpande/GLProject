APP_ENV=development

POSTGRES_PASSWORD=replace_with_local_secret
NEO4J_PASSWORD=replace_with_local_secret
DATABASE_URL=postgresql+psycopg://ekip_user:replace_with_local_secret@localhost:5432/ekip

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

DOCUMENT_STORAGE_ROOT=./storage/documents
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ekip_document_chunks
QDRANT_API_KEY=
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
